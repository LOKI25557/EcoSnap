# Dependencies
**/node_modules/
**/.expo/

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example

# Firebase credentials
service-account*.json
firebase-adminsdk*.json

# Build outputs
**/build/
**/dist/
**/coverage/
**/.expo-shared/

# Android and iOS build artifacts
/mobile-app/android/.gradle/
/mobile-app/android/app/build/
/mobile-app/android/build/
/mobile-app/ios/build/
**/Pods/

# EAS
.eas/

# AI training model binaries
/ai-engine/models/*.keras
/ai-engine/models/*.tflite
/ai-engine/models/*.pb
/ai-engine/models/*.onnx

# AI datasets
/ai-engine/datasets/raw/
/ai-engine/datasets/prepared/
/ai-engine/datasets/processed/
/ai-engine/datasets/splits/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

